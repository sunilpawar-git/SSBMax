-- Phase 2: real read-through/write-through cache for OIR results, replacing
-- the Phase 0 spike's percentage-only row with the full serialized result
-- (resultJson holds a JSON-encoded OirTestResultDto, see OirResultDto.kt),
-- so a cache hit returns the same fidelity as a fresh Firestore read.

CREATE TABLE CachedOirResult (
    submissionId TEXT NOT NULL PRIMARY KEY,
    resultJson TEXT NOT NULL,
    cachedAtEpochMillis INTEGER NOT NULL
);

selectBySubmissionId:
SELECT * FROM CachedOirResult WHERE submissionId = ?;

insertOrReplace:
INSERT OR REPLACE INTO CachedOirResult(submissionId, resultJson, cachedAtEpochMillis)
VALUES (?, ?, ?);

-- Phase 2 continuation (6th slice): local store for TestRepositoryImpl's
-- offline-first test-result persistence (TestResultDao -> TestResultEntity).
-- syncStatus/getPendingSync/updateSyncStatus were dropped, not carried
-- forward: grep confirmed no production caller (only Android instrumentation
-- tests) ever exercises the sync-tracking path, so it was dead scaffolding
-- in the Android original, same category as the GTORepository port's
-- PGT/HGT/GOR/IO/CT dead-code finding.

CREATE TABLE TestResult (
    id TEXT NOT NULL PRIMARY KEY,
    testId TEXT NOT NULL,
    userId TEXT NOT NULL,
    score REAL NOT NULL,
    maxScore REAL NOT NULL,
    completedAt INTEGER NOT NULL,
    timeSpentMinutes INTEGER NOT NULL
);

selectTestResultsByUser:
SELECT * FROM TestResult WHERE userId = ? ORDER BY completedAt DESC;

selectTestResultsByUserAndTest:
SELECT * FROM TestResult WHERE userId = ? AND testId = ? ORDER BY completedAt DESC;

insertOrReplaceTestResult:
INSERT OR REPLACE INTO TestResult(id, testId, userId, score, maxScore, completedAt, timeSpentMinutes)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- Phase 2 continuation (6th slice): local store backing AnalyticsRepositoryImpl
-- (UserPerformanceDao -> UserPerformanceEntity) and its writer,
-- DifficultyProgressionManager. autoGenerate id is emulated via testType||'|'||
-- difficulty as a natural composite key (the Android entity's autoGenerate
-- Long id is never queried by value anywhere -- only testType+difficulty
-- lookups are used -- so a natural key avoids needing a SQLDelight
-- auto-increment id read-back, which the read-only queries never needed).

CREATE TABLE UserPerformance (
    testType TEXT NOT NULL,
    difficulty TEXT NOT NULL,
    totalAttempts INTEGER NOT NULL,
    correctAnswers INTEGER NOT NULL,
    incorrectAnswers INTEGER NOT NULL,
    averageScore REAL NOT NULL,
    averageTimeSeconds REAL NOT NULL,
    currentLevel TEXT NOT NULL,
    readyForNextLevel INTEGER NOT NULL,
    lastAttemptAt INTEGER NOT NULL,
    firstAttemptAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    PRIMARY KEY (testType, difficulty)
);

selectPerformance:
SELECT * FROM UserPerformance WHERE testType = ? AND difficulty = ?;

selectPerformanceByTestType:
SELECT * FROM UserPerformance WHERE testType = ? ORDER BY difficulty ASC;

selectAllPerformance:
SELECT * FROM UserPerformance ORDER BY testType, difficulty;

insertOrReplacePerformance:
INSERT OR REPLACE INTO UserPerformance(
    testType, difficulty, totalAttempts, correctAnswers, incorrectAnswers,
    averageScore, averageTimeSeconds, currentLevel, readyForNextLevel,
    lastAttemptAt, firstAttemptAt, updatedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deletePerformanceByTestType:
DELETE FROM UserPerformance WHERE testType = ?;

deleteAllPerformance:
DELETE FROM UserPerformance;

-- Phase 2 continuation (8th slice): local store backing GitLiveGTOTaskCacheManager
-- (GTOTaskCacheDao -> CachedGTOTaskEntity/GTOBatchMetadataEntity), closing the
-- named gap flagged in the 5th slice's GitLiveGTORepository port: cacheTestContent
-- /clearCache/isContentCached for GD/LECTURETTE previously returned honest
-- "not cached" defaults because this table didn't exist yet.
-- Only the DAO surface GTOTaskCacheManager actually calls is ported here --
-- getAllTasks, getTasksByBatch, the plain (non-least-used) getTasksByType/
-- getRandomTasks, getTasksByCategory/getTaskCountByCategory,
-- getTasksByDifficulty/getTaskCountByDifficulty, getAllTaskTypes/
-- getAllCategories, deleteTasksByBatch, single insertTask, single
-- getBatchMetadata, and deleteBatchMetadata were all confirmed (grep across
-- core/data + app) to have zero callers outside GTOTaskCacheDao's own test --
-- same "dead scaffolding in the Android original" category as TestResult's
-- dropped syncStatus columns above.

CREATE TABLE CachedGTOTask (
    id TEXT NOT NULL PRIMARY KEY,
    taskType TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    instructions TEXT NOT NULL,
    timeAllowedMinutes INTEGER NOT NULL,
    difficultyLevel TEXT,
    category TEXT,
    scenario TEXT,
    resources TEXT,
    objectives TEXT,
    evaluationCriteria TEXT,
    batchId TEXT NOT NULL,
    cachedAt INTEGER NOT NULL,
    lastUsed INTEGER,
    usageCount INTEGER NOT NULL
);

CREATE TABLE GTOBatchMetadata (
    batchId TEXT NOT NULL PRIMARY KEY,
    downloadedAt INTEGER NOT NULL,
    taskCount INTEGER NOT NULL,
    version TEXT NOT NULL
);

selectTotalGTOTaskCount:
SELECT COUNT(*) FROM CachedGTOTask;

selectGTOTaskCountByType:
SELECT COUNT(*) FROM CachedGTOTask WHERE taskType = ?;

selectLeastUsedGTOTasks:
SELECT * FROM CachedGTOTask ORDER BY usageCount ASC, lastUsed ASC LIMIT ?;

selectLeastUsedGTOTasksByType:
SELECT * FROM CachedGTOTask WHERE taskType = ? ORDER BY usageCount ASC, lastUsed ASC LIMIT ?;

insertOrReplaceGTOTask:
INSERT OR REPLACE INTO CachedGTOTask(
    id, taskType, title, description, instructions, timeAllowedMinutes,
    difficultyLevel, category, scenario, resources, objectives,
    evaluationCriteria, batchId, cachedAt, lastUsed, usageCount
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markGTOTasksUsed:
UPDATE CachedGTOTask SET usageCount = usageCount + 1, lastUsed = :timestamp WHERE id IN :taskIds;

clearAllGTOTasks:
DELETE FROM CachedGTOTask;

insertOrReplaceGTOBatchMetadata:
INSERT OR REPLACE INTO GTOBatchMetadata(batchId, downloadedAt, taskCount, version)
VALUES (?, ?, ?, ?);

selectAllGTOBatchMetadata:
SELECT * FROM GTOBatchMetadata ORDER BY downloadedAt DESC;

selectTotalGTOBatchCount:
SELECT COUNT(*) FROM GTOBatchMetadata;

-- Phase 2 continuation (9th slice): local store backing GitLiveWATWordCacheManager
-- (WATWordCacheDao -> CachedWATWordEntity/WATBatchMetadataEntity), the smallest
-- remaining Room DAO+manager pair (single word table + batch-metadata table, no
-- cross-table joins), chosen over GPEImageCacheDao/PPDTImageCacheDao/
-- SRTSituationCacheDao/TATImageCacheDao/InterviewQuestionCacheDao for this
-- reason -- all six are equally blocked as a group by TestContentRepositoryImpl
-- (which needs all six cache managers before it can be ported), so file/method
-- count was the deciding factor, same rationale used to pick GTOTaskCacheDao
-- over OIRQuestionCacheDao in the 8th slice.
-- Only the DAO surface WATWordCacheManager actually calls is ported here --
-- getAllWords, getWordsByBatch, getRandomWords, getWordsByCategory,
-- getWordsByDifficulty, single insertWord, deleteWordsByBatch,
-- getWordCountByDifficulty, getBatchMetadata (single), and deleteBatchMetadata
-- were all confirmed (grep across core/data + app, excluding Room's own DAO
-- test) to have zero callers outside WATWordCacheDaoTest -- same "dead
-- scaffolding in the Android original" category as the 8th slice's
-- GTOTaskCacheDao finding.

CREATE TABLE CachedWATWord (
    id TEXT NOT NULL PRIMARY KEY,
    word TEXT NOT NULL,
    sequenceNumber INTEGER NOT NULL,
    timeAllowedSeconds INTEGER NOT NULL,
    category TEXT,
    difficulty TEXT,
    batchId TEXT NOT NULL,
    cachedAt INTEGER NOT NULL,
    lastUsed INTEGER,
    usageCount INTEGER NOT NULL
);

CREATE TABLE WATBatchMetadata (
    batchId TEXT NOT NULL PRIMARY KEY,
    downloadedAt INTEGER NOT NULL,
    wordCount INTEGER NOT NULL,
    version TEXT NOT NULL
);

selectTotalWATWordCount:
SELECT COUNT(*) FROM CachedWATWord;

selectWATWordCountByCategory:
SELECT COUNT(*) FROM CachedWATWord WHERE category = ?;

selectLeastUsedWATWords:
SELECT * FROM CachedWATWord ORDER BY usageCount ASC, lastUsed ASC LIMIT ?;

insertOrReplaceWATWord:
INSERT OR REPLACE INTO CachedWATWord(
    id, word, sequenceNumber, timeAllowedSeconds, category, difficulty,
    batchId, cachedAt, lastUsed, usageCount
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markWATWordsUsed:
UPDATE CachedWATWord SET usageCount = usageCount + 1, lastUsed = :timestamp WHERE id IN :wordIds;

clearAllWATWords:
DELETE FROM CachedWATWord;

insertOrReplaceWATBatchMetadata:
INSERT OR REPLACE INTO WATBatchMetadata(batchId, downloadedAt, wordCount, version)
VALUES (?, ?, ?, ?);

selectAllWATBatchMetadata:
SELECT * FROM WATBatchMetadata ORDER BY downloadedAt DESC;

selectTotalWATBatchCount:
SELECT COUNT(*) FROM WATBatchMetadata;

-- Phase 2 continuation (10th slice): local store backing GitLiveGPEImageCacheManager
-- (GPEImageCacheDao -> CachedGPEImageEntity/GPEBatchMetadataEntity).
-- Only the DAO surface GPEImageCacheManager actually calls is ported here --
-- getAllImages, getImagesByBatch, getRandomImages, getImagesByCategory,
-- getImagesByDifficulty, getDownloadedImages, getImagesNeedingDownload,
-- markImageAsDownloaded, single insertImage, deleteImagesByBatch,
-- getImageCountByCategory, getImageCountByDifficulty, getAllCategories,
-- and single getBatchMetadata were all confirmed (grep across core/data + app,
-- excluding Room's own DAO test) to have zero callers outside GPEImageCacheDao's
-- own test -- same "dead scaffolding" category as the 8th/9th slices' findings.
-- localFilePath/imageDownloaded columns are dropped entirely: markImageAsDownloaded
-- (the only writer of either) has zero production callers even on Android, so
-- imageDownloaded is always 0 there already -- getDownloadedImageCount is ported
-- as a literal 0L in the manager rather than a query, documented at the call site.

CREATE TABLE CachedGPEImage (
    id TEXT NOT NULL PRIMARY KEY,
    imageUrl TEXT NOT NULL,
    scenario TEXT NOT NULL,
    solution TEXT,
    imageDescription TEXT NOT NULL,
    resources TEXT,
    viewingTimeSeconds INTEGER NOT NULL,
    planningTimeSeconds INTEGER NOT NULL,
    minCharacters INTEGER NOT NULL,
    maxCharacters INTEGER NOT NULL,
    category TEXT,
    difficulty TEXT,
    batchId TEXT NOT NULL,
    cachedAt INTEGER NOT NULL,
    lastUsed INTEGER,
    usageCount INTEGER NOT NULL
);

CREATE TABLE GPEBatchMetadata (
    batchId TEXT NOT NULL PRIMARY KEY,
    downloadedAt INTEGER NOT NULL,
    imageCount INTEGER NOT NULL,
    version TEXT NOT NULL
);

selectTotalGPEImageCount:
SELECT COUNT(*) FROM CachedGPEImage;

selectLeastUsedGPEImages:
SELECT * FROM CachedGPEImage ORDER BY usageCount ASC, RANDOM() LIMIT ?;

insertOrReplaceGPEImage:
INSERT OR REPLACE INTO CachedGPEImage(
    id, imageUrl, scenario, solution, imageDescription, resources,
    viewingTimeSeconds, planningTimeSeconds, minCharacters, maxCharacters,
    category, difficulty, batchId, cachedAt, lastUsed, usageCount
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markGPEImagesUsed:
UPDATE CachedGPEImage SET usageCount = usageCount + 1, lastUsed = :timestamp WHERE id IN :imageIds;

clearAllGPEImages:
DELETE FROM CachedGPEImage;

insertOrReplaceGPEBatchMetadata:
INSERT OR REPLACE INTO GPEBatchMetadata(batchId, downloadedAt, imageCount, version)
VALUES (?, ?, ?, ?);

deleteGPEBatchMetadata:
DELETE FROM GPEBatchMetadata WHERE batchId = ?;

selectAllGPEBatchMetadata:
SELECT * FROM GPEBatchMetadata ORDER BY downloadedAt DESC;

selectTotalGPEBatchCount:
SELECT COUNT(*) FROM GPEBatchMetadata;

-- Phase 2 continuation (11th slice): local store backing GitLivePPDTImageCacheManager
-- (PPDTImageCacheDao -> CachedPPDTImageEntity/PPDTBatchMetadataEntity).
-- Only the DAO surface PPDTImageCacheManager actually calls is ported here --
-- getAllImages, getImagesByBatch, getRandomImages, getImagesByCategory,
-- getImagesByDifficulty, getDownloadedImages, getImagesNeedingDownload,
-- markImageAsDownloaded, single insertImage, deleteImagesByBatch,
-- getImageCountByCategory, getImageCountByDifficulty, and getAllCategories
-- were all confirmed (grep across core/data + app, excluding Room's own DAO
-- tests) to have zero callers outside PPDTImageCacheDao's own tests -- same
-- category as the 10th slice's GPE finding. localFilePath/imageDownloaded
-- dropped for the same reason as GPE (markImageAsDownloaded is dead on
-- Android too, so imageDownloaded is always 0 there already).

CREATE TABLE CachedPPDTImage (
    id TEXT NOT NULL PRIMARY KEY,
    imageUrl TEXT NOT NULL,
    imageDescription TEXT NOT NULL,
    imageContextJson TEXT NOT NULL,
    viewingTimeSeconds INTEGER NOT NULL,
    writingTimeMinutes INTEGER NOT NULL,
    minCharacters INTEGER NOT NULL,
    maxCharacters INTEGER NOT NULL,
    category TEXT,
    difficulty TEXT,
    batchId TEXT NOT NULL,
    cachedAt INTEGER NOT NULL,
    lastUsed INTEGER,
    usageCount INTEGER NOT NULL,
    genderTag TEXT NOT NULL
);

CREATE TABLE PPDTBatchMetadata (
    batchId TEXT NOT NULL PRIMARY KEY,
    downloadedAt INTEGER NOT NULL,
    imageCount INTEGER NOT NULL,
    version TEXT NOT NULL,
    lastStalenessCheckAt INTEGER NOT NULL
);

selectTotalPPDTImageCount:
SELECT COUNT(*) FROM CachedPPDTImage;

selectLeastUsedPPDTImages:
SELECT * FROM CachedPPDTImage ORDER BY usageCount ASC, RANDOM() LIMIT ?;

selectLeastUsedPPDTImagesByGender:
SELECT * FROM CachedPPDTImage
WHERE genderTag = :tag OR genderTag = 'MIXED'
ORDER BY usageCount ASC, RANDOM()
LIMIT :count;

selectPPDTImageById:
SELECT * FROM CachedPPDTImage WHERE id = ?;

insertOrReplacePPDTImage:
INSERT OR REPLACE INTO CachedPPDTImage(
    id, imageUrl, imageDescription, imageContextJson, viewingTimeSeconds,
    writingTimeMinutes, minCharacters, maxCharacters, category, difficulty,
    batchId, cachedAt, lastUsed, usageCount, genderTag
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markPPDTImagesUsed:
UPDATE CachedPPDTImage SET usageCount = usageCount + 1, lastUsed = :timestamp WHERE id IN :imageIds;

clearAllPPDTImages:
DELETE FROM CachedPPDTImage;

insertOrReplacePPDTBatchMetadata:
INSERT OR REPLACE INTO PPDTBatchMetadata(batchId, downloadedAt, imageCount, version, lastStalenessCheckAt)
VALUES (?, ?, ?, ?, ?);

selectPPDTBatchMetadata:
SELECT * FROM PPDTBatchMetadata WHERE batchId = ?;

selectAllPPDTBatchMetadata:
SELECT * FROM PPDTBatchMetadata ORDER BY downloadedAt DESC;

selectTotalPPDTBatchCount:
SELECT COUNT(*) FROM PPDTBatchMetadata;

-- Phase 2 continuation (12th slice): local store backing GitLiveSRTSituationCacheManager
-- (SRTSituationCacheDao -> CachedSRTSituationEntity/SRTBatchMetadataEntity).
-- Only the DAO surface SRTSituationCacheManager actually calls is ported here --
-- getAllSituations, getSituationsByBatch, getRandomSituations,
-- getSituationsByCategory (plain), getSituationsByDifficulty, single
-- insertSituation, deleteSituationsByBatch, getAllCategories, single
-- getBatchMetadata, and deleteBatchMetadata were all confirmed (grep across
-- core/data + app, excluding Room's own DAO test) to have zero callers outside
-- SRTSituationCacheDaoTest -- same category as prior slices' findings.

CREATE TABLE CachedSRTSituation (
    id TEXT NOT NULL PRIMARY KEY,
    situation TEXT NOT NULL,
    sequenceNumber INTEGER NOT NULL,
    category TEXT NOT NULL,
    timeAllowedSeconds INTEGER NOT NULL,
    difficulty TEXT,
    batchId TEXT NOT NULL,
    cachedAt INTEGER NOT NULL,
    lastUsed INTEGER,
    usageCount INTEGER NOT NULL
);

CREATE TABLE SRTBatchMetadata (
    batchId TEXT NOT NULL PRIMARY KEY,
    downloadedAt INTEGER NOT NULL,
    situationCount INTEGER NOT NULL,
    version TEXT NOT NULL
);

selectTotalSRTSituationCount:
SELECT COUNT(*) FROM CachedSRTSituation;

selectLeastUsedSRTSituations:
SELECT * FROM CachedSRTSituation ORDER BY usageCount ASC, lastUsed ASC LIMIT ?;

selectBalancedSRTByCategory:
SELECT * FROM CachedSRTSituation
WHERE category = :category
ORDER BY usageCount ASC, RANDOM()
LIMIT :count;

markSRTSituationsUsed:
UPDATE CachedSRTSituation SET usageCount = usageCount + 1, lastUsed = :timestamp WHERE id IN :situationIds;

insertOrReplaceSRTSituation:
INSERT OR REPLACE INTO CachedSRTSituation(
    id, situation, sequenceNumber, category, timeAllowedSeconds, difficulty,
    batchId, cachedAt, lastUsed, usageCount
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

clearAllSRTSituations:
DELETE FROM CachedSRTSituation;

insertOrReplaceSRTBatchMetadata:
INSERT OR REPLACE INTO SRTBatchMetadata(batchId, downloadedAt, situationCount, version)
VALUES (?, ?, ?, ?);

selectAllSRTBatchMetadata:
SELECT * FROM SRTBatchMetadata ORDER BY downloadedAt DESC;

selectTotalSRTBatchCount:
SELECT COUNT(*) FROM SRTBatchMetadata;

selectSRTSituationCountByCategory:
SELECT COUNT(*) FROM CachedSRTSituation WHERE category = ?;

-- Phase 2 continuation (13th slice): local store backing GitLiveTATImageCacheManager
-- (TATImageCacheDao -> CachedTATImageEntity/TATBatchMetadataEntity). Only the
-- DAO surface TATImageCacheManager actually calls is ported here -- getAllImages,
-- getImagesByBatch, getImagesByCategory, getImagesByDifficulty, single
-- insertImage, deleteImagesByBatch, getImageCountByCategory, getAllCategories,
-- and deleteBatchMetadata were all confirmed (grep across core/data + app,
-- excluding Room's own DAO test) to have zero callers outside
-- TATImageCacheDao's own test -- same category as prior slices' findings.

CREATE TABLE CachedTATImage (
    id TEXT NOT NULL PRIMARY KEY,
    imageUrl TEXT NOT NULL,
    cardPosition INTEGER NOT NULL,
    genderTag TEXT NOT NULL,
    imageContextJson TEXT NOT NULL,
    viewingTimeSeconds INTEGER NOT NULL,
    writingTimeMinutes INTEGER NOT NULL,
    minCharacters INTEGER NOT NULL,
    maxCharacters INTEGER NOT NULL,
    category TEXT,
    difficulty TEXT,
    batchId TEXT NOT NULL,
    cachedAt INTEGER NOT NULL,
    lastUsed INTEGER,
    usageCount INTEGER NOT NULL
);

CREATE TABLE TATBatchMetadata (
    batchId TEXT NOT NULL PRIMARY KEY,
    downloadedAt INTEGER NOT NULL,
    imageCount INTEGER NOT NULL,
    version TEXT NOT NULL,
    lastStalenessCheckAt INTEGER NOT NULL
);

selectTotalTATImageCount:
SELECT COUNT(*) FROM CachedTATImage;

selectLeastUsedTATImageByPosition:
SELECT * FROM CachedTATImage
WHERE cardPosition = :cardPosition
  AND (genderTag = :genderTag OR genderTag = 'MIXED')
ORDER BY usageCount ASC, RANDOM()
LIMIT 1;

markTATImagesUsed:
UPDATE CachedTATImage SET usageCount = usageCount + 1, lastUsed = :timestamp WHERE id IN :imageIds;

insertOrReplaceTATImage:
INSERT OR REPLACE INTO CachedTATImage(
    id, imageUrl, cardPosition, genderTag, imageContextJson, viewingTimeSeconds,
    writingTimeMinutes, minCharacters, maxCharacters, category, difficulty,
    batchId, cachedAt, lastUsed, usageCount
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

clearAllTATImages:
DELETE FROM CachedTATImage;

insertOrReplaceTATBatchMetadata:
INSERT OR REPLACE INTO TATBatchMetadata(batchId, downloadedAt, imageCount, version, lastStalenessCheckAt)
VALUES (?, ?, ?, ?, ?);

selectTATBatchMetadata:
SELECT * FROM TATBatchMetadata WHERE batchId = ?;

selectAllTATBatchMetadata:
SELECT * FROM TATBatchMetadata ORDER BY downloadedAt DESC;

selectTotalTATBatchCount:
SELECT COUNT(*) FROM TATBatchMetadata;

-- Phase 2 continuation (14th slice): local store backing GitLiveOIRQuestionCacheManager
-- + GitLiveOIRQuestionSelector (OIRQuestionCacheDao -> CachedOIRQuestionEntity/
-- OIRBatchMetadataEntity/OIRSyncMetadataEntity). Largest remaining Room DAO --
-- kept as two Kotlin classes (manager + selector), mirroring the Android
-- original's own split, to respect this repo's 300-line-per-file limit; a
-- merged single class would run well past 300 lines once Firestore parsing +
-- selection logic + status/status-mapping are combined.
-- Only the DAO surface the manager+selector actually call is ported here --
-- getQuestionsByBatches, single getQuestionById, getAllQuestions, single
-- insertQuestion, deleteBatch, deleteOldestQuestions, single getBatchMetadata,
-- getBatchCount, deleteBatchMetadata, getUsageStatistics, getMostUsedQuestions,
-- and getLeastUsedQuestions were all confirmed (grep across core/data + app,
-- excluding Room's own DAO test) to have zero callers outside
-- OIRQuestionCacheDao's own test -- same category as prior slices' findings.

CREATE TABLE CachedOIRQuestion (
    id TEXT NOT NULL PRIMARY KEY,
    questionNumber INTEGER NOT NULL,
    type TEXT NOT NULL,
    subtype TEXT,
    questionText TEXT NOT NULL,
    optionsJson TEXT NOT NULL,
    correctAnswerId TEXT NOT NULL,
    explanation TEXT NOT NULL,
    questionImageUrl TEXT,
    difficulty TEXT NOT NULL,
    tags TEXT NOT NULL,
    batchId TEXT NOT NULL,
    cachedAt INTEGER NOT NULL,
    lastUsed INTEGER,
    usageCount INTEGER NOT NULL,
    correctAnswerIds TEXT
);

CREATE TABLE OIRBatchMetadata (
    batchId TEXT NOT NULL PRIMARY KEY,
    downloadedAt INTEGER NOT NULL,
    questionCount INTEGER NOT NULL,
    version TEXT NOT NULL
);

CREATE TABLE OIRSyncMetadata (
    id INTEGER NOT NULL PRIMARY KEY,
    contentVersion INTEGER NOT NULL,
    lastSyncAt INTEGER NOT NULL
);

selectUnusedOIRQuestionsByType:
SELECT * FROM CachedOIRQuestion
WHERE type = :type
AND (lastUsed IS NULL OR lastUsed < :olderThan)
ORDER BY RANDOM()
LIMIT :count;

selectOIRQuestionsByType:
SELECT * FROM CachedOIRQuestion WHERE type = :type ORDER BY RANDOM() LIMIT :count;

selectTotalOIRQuestionCount:
SELECT COUNT(*) FROM CachedOIRQuestion;

selectOIRQuestionCountByType:
SELECT COUNT(*) FROM CachedOIRQuestion WHERE type = ?;

insertOrReplaceOIRQuestion:
INSERT OR REPLACE INTO CachedOIRQuestion(
    id, questionNumber, type, subtype, questionText, optionsJson, correctAnswerId,
    explanation, questionImageUrl, difficulty, tags, batchId, cachedAt, lastUsed,
    usageCount, correctAnswerIds
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markOIRQuestionsUsed:
UPDATE CachedOIRQuestion SET lastUsed = :timestamp, usageCount = usageCount + 1 WHERE id IN :questionIds;

deleteAllOIRQuestions:
DELETE FROM CachedOIRQuestion;

selectAllOIRBatchMetadata:
SELECT * FROM OIRBatchMetadata ORDER BY downloadedAt DESC;

countOIRBatchMetadataById:
SELECT COUNT(*) FROM OIRBatchMetadata WHERE batchId = ?;

insertOrReplaceOIRBatchMetadata:
INSERT OR REPLACE INTO OIRBatchMetadata(batchId, downloadedAt, questionCount, version)
VALUES (?, ?, ?, ?);

deleteAllOIRBatchMetadata:
DELETE FROM OIRBatchMetadata;

selectOIRSyncMetadata:
SELECT * FROM OIRSyncMetadata WHERE id = 0;

upsertOIRSyncMetadata:
INSERT OR REPLACE INTO OIRSyncMetadata(id, contentVersion, lastSyncAt)
VALUES (0, ?, ?);

-- Phase 2 continuation (16th slice): local store backing
-- GitLiveNotificationCacheManager (NotificationDao -> NotificationEntity).
-- Only the DAO surface NotificationRepositoryImpl actually calls is ported
-- here -- insert, getNotifications, getUnreadCount, markAsRead,
-- markAllAsRead, delete. deleteAll(userId) and deleteExpired(currentTime)
-- were confirmed (grep across core/data + app) to have zero callers outside
-- NotificationDao's own test -- same "dead scaffolding in the Android
-- original" category as prior slices' findings. isRead is stored as INTEGER
-- (0/1) since SQLDelight has no native Boolean affinity on this driver set.
CREATE TABLE Notification (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    type TEXT NOT NULL,
    priority TEXT NOT NULL,
    title TEXT NOT NULL,
    message TEXT NOT NULL,
    imageUrl TEXT,
    actionUrl TEXT,
    actionDataJson TEXT,
    isRead INTEGER NOT NULL,
    createdAt INTEGER NOT NULL,
    expiresAt INTEGER
);

insertOrReplaceNotification:
INSERT OR REPLACE INTO Notification(
    id, userId, type, priority, title, message, imageUrl, actionUrl,
    actionDataJson, isRead, createdAt, expiresAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectNotificationsByUser:
SELECT * FROM Notification WHERE userId = :userId ORDER BY createdAt DESC;

selectUnreadNotificationCount:
SELECT COUNT(*) FROM Notification WHERE userId = :userId AND isRead = 0;

markNotificationAsRead:
UPDATE Notification SET isRead = 1 WHERE id = :notificationId;

markAllNotificationsAsRead:
UPDATE Notification SET isRead = 1 WHERE userId = :userId;

deleteNotificationById:
DELETE FROM Notification WHERE id = :notificationId;
